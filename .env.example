# Copy to .env for local development. Never commit real secrets.
# Load these into the process environment before ./gradlew bootRun.
# Database must be PostgreSQL with PostGIS (recommended: postgis/postgis:17-3.5).

# Optional — omit to use the default "local" profile
# SPRING_PROFILES_ACTIVE=local

DB_URL=jdbc:postgresql://localhost:5432/proxigaz
DB_USER=proxigaz
DB_PASSWORD=proxigaz

# Must be long enough for HMAC-SHA256. Override in every non-local environment.
# Staging/production refuse the local placeholder below.
JWT_SECRET=proxigaz-dev-secret-key-0123456789abcdef0123456789abcdef

# Optional Liquibase contexts (leave empty for default)
LIQUIBASE_CONTEXT=

# --- staging / production example (no defaults in YAML) ---
# SPRING_PROFILES_ACTIVE=staging
# DB_URL=jdbc:postgresql://staging-host:5432/proxigaz
# DB_USER=proxigaz
# DB_PASSWORD=replace-me
# JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
