<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
	xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">

	<changeSet id="PXG-058:1" author="Jemil-Dilan">
		<comment>Add last_used_at and revoked_at columns to vendor_sessions
			for session management</comment>
		<addColumn tableName="t_vendor_sessions">
			<column name="c_last_used_at" type="timestamptz" />
		</addColumn>
		<addColumn tableName="t_vendor_sessions">
			<column name="c_revoked_at" type="timestamptz" />
		</addColumn>
	</changeSet>

	<changeSet id="PXG-058:2" author="Jemil-Dilan">
		<comment>Remove deprecated c_expires_at column from vendor_sessions</comment>
		<dropColumn tableName="t_vendor_sessions"
			columnName="c_expires_at" />
	</changeSet>

</databaseChangeLog>
